# Replace the artificial separated/L-shaped FOV profile with the
# production-style continuous zoom arc:
#
#   start FOV -> max FOV -> destination FOV
#
# Translation/rotation still use translateStart/translationComplete,
# but FOV no longer waits at max FOV during motion.
pattern = re.compile(
    r"""    #fovAt\(t, startFov, destinationFov, immediate = false\) \{
.*?
    \}
    #distanceProgress\(t\) \{""",
    re.S
)

replacement = """    #fovAt(t, startFov, destinationFov, immediate = false) {
      if (immediate) {
        const progress = clamp01(t);
        return Math.exp(
          Math.log(startFov) +
          (Math.log(destinationFov)-Math.log(startFov))*progress
        );
      }

      // DOE 0095 — continuous production-style camera arc.
      //
      // FOV changes continuously for the entire flight:
      //
      //   start FOV
      //      \\
      //       \\   zoom outward
      //        \\____ maximum FOV near the midpoint
      //             \\
      //              \\ zoom inward
      //               \\ destination FOV
      //
      // Translation + rotation overlap this curve according to the
      // DOE motion window. There is no hard hold at maximum FOV.

      const turn =
        clamp01(Number(this.options.turnPoint));

      const maximum =
        Number(this.options.maxFov);

      const safeTurn =
        Math.max(.000001,Math.min(.999999,turn));

      if (t <= safeTurn) {
        const progress =
          navigationSmootherstep(
            t/safeTurn
          );

        return Math.exp(
          Math.log(startFov) +
          (Math.log(maximum)-Math.log(startFov))*progress
        );
      }

      const progress =
        navigationSmootherstep(
          (t-safeTurn)/
          Math.max(1-safeTurn,.000001)
        );

      return Math.exp(
        Math.log(maximum) +
        (Math.log(destinationFov)-Math.log(maximum))*progress
      );
    }
    #distanceProgress(t) {"""

rg,n = pattern.subn(replacement,rg,count=1)

if n != 1:
    raise SystemExit(
        f"CONTINUOUS FOV FUNCTION REPLACEMENT COUNT={n}"
    )


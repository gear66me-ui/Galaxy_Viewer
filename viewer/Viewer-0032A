from IPython.display import HTML, display

# viewer-0032
# Galaxy Viewer — Viewer 32
# Added:
# - Auto SIMBAD on target press
# - Navigation lock + banner
# - Auto unlock after drag attempts
# - Fullscreen API support

display(HTML(r"""
<link rel="stylesheet" href="https://aladin.cds.unistra.fr/AladinLite/api/v3/3.8.2/aladin.min.css" />

<style>
#aladin-cosmic-command-test{
    width:100%;height:650px;position:relative!important;
    --text-blue:#62D8FF;--copy-blue:#7DF4FF;
}

/* NAV LOCK BANNER */
#gv-nav-lock{
    position:absolute;
    top:10px;
    left:50%;
    transform:translateX(-50%);
    background:#000;
    color:#62D8FF;
    padding:8px 14px;
    border:1px solid #247EAE;
    z-index:9999;
    cursor:pointer;
    font-size:12px;
    text-align:center;
}
</style>

<div id="aladin-cosmic-command-test"></div>

<script src="https://aladin.cds.unistra.fr/AladinLite/api/v3/3.8.2/aladin.js"></script>

<script>
A.init.then(() => {

    const root=document.getElementById("aladin-cosmic-command-test");

    const aladin=A.aladin("#aladin-cosmic-command-test",{
        target:"M 31",
        survey:"P/DSS2/color",
        fov:1.5,
        cooFrame:"ICRSd",
        projection:"TAN",
        showSimbadPointerControl:true,
        showFullscreenControl:true
    });

    // =========================
    // STATE
    // =========================
    let gv_navLocked=false;
    let gv_dragAttempts=0;
    let gv_lockedCoords=null;

    // =========================
    // NAV LOCK
    // =========================
    function gv_lock(){
        const c=aladin.getCenter();
        gv_navLocked=true;
        gv_dragAttempts=0;
        gv_lockedCoords={ra:c.ra,dec:c.dec};
        gv_showBanner();
    }

    function gv_unlock(){
        gv_navLocked=false;
        gv_dragAttempts=0;
        gv_lockedCoords=null;

        const b=document.getElementById("gv-nav-lock");
        if(b) b.remove();
    }

    function gv_showBanner(){
        if(document.getElementById("gv-nav-lock")) return;

        const b=document.createElement("div");
        b.id="gv-nav-lock";
        b.innerText="🔒 NAVIGATION LOCKED\nTAP HERE TO CLEAR";
        b.onclick=gv_unlock;

        root.appendChild(b);
    }

    // =========================
    // AUTO SIMBAD
    // =========================
    function triggerSimbad(){
        const btn=root.querySelector(
            "button.aladin-simbadPointer-control,button.aladin-btn[class*='simbadPointer']"
        );
        if(btn) btn.click();
    }

    // =========================
    // TARGET BUTTON INTERCEPT
    // =========================
    function hookTarget(){
        const btn=root.querySelector(
            "button.aladin-simbadPointer-control,button.aladin-btn[class*='simbadPointer']"
        );
        if(!btn || btn.dataset.gvHooked) return;

        btn.dataset.gvHooked="1";

        btn.addEventListener("click",(e)=>{
            e.stopPropagation();

            gv_lock();
            triggerSimbad();
        });
    }

    // =========================
    // DRAG DETECTION
    // =========================
    aladin.on('positionChanged',()=>{
        if(gv_navLocked && gv_lockedCoords){

            gv_dragAttempts++;

            aladin.gotoRaDec(
                gv_lockedCoords.ra,
                gv_lockedCoords.dec
            );

            if(gv_dragAttempts>=3){
                gv_unlock();
            }
        }
    });

    // =========================
    // FULLSCREEN SUPPORT
    // =========================
    function toggleFullscreen(){
        if(!document.fullscreenElement){
            root.requestFullscreen?.();
        }else{
            document.exitFullscreen?.();
        }
    }

    const fsBtn=root.querySelector("[title='Fullscreen']");
    if(fsBtn){
        fsBtn.addEventListener("click",toggleFullscreen);
    }

    // =========================
    // INIT LOOP
    // =========================
    setInterval(hookTarget,500);

});
</script>
"""))
